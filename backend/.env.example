# ===== DATABASE =====
# Produção (Railway): SQLite em volume persistente montado em /data
#   -> definido no Dockerfile: DATABASE_URL=sqlite:////data/estoque_virtual.db
# Desenvolvimento local: SQLite no diretório do backend
DATABASE_URL=sqlite:///./estoque_virtual.db
# Alternativa (caso migre para Postgres):
# DATABASE_URL=postgresql://user:password@host:5432/estoque_virtual

# ===== UPLOADS =====
UPLOAD_DIR=./uploads
ALLOWED_EXTENSIONS=xml,pdf
MAX_FILE_SIZE=10485760

# ===== OLIST INTEGRATION =====
# Token API Simples (Tiny)
OLIST_API_TOKEN_SIMPLE=sua_chave_aqui

# OAuth2 Credentials
OLIST_CLIENT_ID=seu_client_id
OLIST_CLIENT_SECRET=seu_client_secret
OLIST_REDIRECT_URI=https://sua-api.railway.app/api/olist/callback

# ===== ALERTAS DE ESTOQUE (monitor_estoque.py) =====
# Provider: telegram | twilio | evolution | cloud | webhook | log
# Vazio = detecta pelas credenciais presentes; sem nenhuma, cai em "log" (não envia nada).
ALERTA_PROVIDER=
# Janela anti-spam em minutos (mesma mensagem não é reenviada dentro dela). Default: 60
ALERTA_DEDUP_MIN=60

# -- provider "telegram" (recomendado: gratuito e oficial)
# 1) No Telegram, fale com @BotFather -> /newbot -> copie o token pra cá
# TELEGRAM_BOT_TOKEN=
# 2) Mande qualquer mensagem pro seu bot e rode: python -m app.notificacoes
#    Ele imprime o chat id pra colar aqui.
# TELEGRAM_CHAT_ID=

# -- destino dos providers de WhatsApp: só dígitos com DDI (ex.: 5511999999999)
# WHATSAPP_NUMBER=

# -- provider "twilio"
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=

# -- provider "evolution" (API self-hosted)
# EVOLUTION_URL=
# EVOLUTION_INSTANCE=
# EVOLUTION_APIKEY=

# -- provider "cloud" (WhatsApp Cloud API oficial da Meta)
# WA_CLOUD_PHONE_ID=
# WA_CLOUD_TOKEN=
# WA_CLOUD_API_VERSION=v20.0

# -- provider "webhook" (POST genérico com {"phone":..., "message":...})
# WA_WEBHOOK_URL=
# WA_WEBHOOK_TOKEN=

# ===== GENERAL =====
DEBUG=False
